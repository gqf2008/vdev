;
; vdev-display.inf — vdev 虚拟显示器（IddCx UMDF 驱动）
;

[Version]
PnpLockdown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=vdev-display.cat
; M7：DriverVer 与 driver/Cargo.toml 的 package version（0.4.0）同步
DriverVer = 08/22/2026,0.4.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=vdev_display_Install, Root\vdev-display

[SourceDisksFiles]
vdev_display.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[vdev_display_Install.NT]
CopyFiles=UMDriverCopy

[vdev_display_Install.NT.hw]
AddReg = vdev_display_HardwareDeviceSettings

[vdev_display_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "vdev-display-group"

[vdev_display_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[vdev_display_Install.NT.Wdf]
UmdfService=vdev-display,vdev_display_Install
UmdfServiceOrder=vdev-display
UmdfKernelModeClientPolicy = AllowKernelModeClients

; M7 核对结论（出处）：
; - UmdfLibraryVersion=2.31.0 与 wdf-umdf-sys/build.rs 的 UMDF_V="2.31"
;   （WdfDriverStubUm 链接版本；代码经 WdfFunctions_02031 函数表调用）一致。
;   原值 2.25.0 与实际链接的 UMDF 2.31 存根不匹配。
; - UmdfExtensions=IddCx0102 与微软官方样例 IddSampleDriver.inf
;   （github.com/microsoft/Windows-driver-samples video/IndirectDisplay，
;   [IddSampleDriver_Install] 节）写法一致。
; - 关于 IddMinimumVersionRequired：微软样例 INF 中没有该 INF 指令；
;   它是 IddCx 存根库要求客户端提供的链接期符号（本仓库
;   wdf-umdf-sys/src/bindings.rs 以 #[no_mangle] static = 4 提供，
;   对应 build.rs IDDCX_V="1.4"），不是 INF 指令，本 INF 无需也不应声明。
[vdev_display_Install]
UmdfLibraryVersion=2.31.0
ServiceBinary=%12%\UMDF\vdev_display.dll
UmdfExtensions = IddCx0102

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
vdev_display.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="vdev"
DiskName = "vdev Display Installation Disk"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName="vdev 虚拟显示器"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
REG_EXPAND_SZ = 0x00020000
REG_DWORD     = 0x00010001

