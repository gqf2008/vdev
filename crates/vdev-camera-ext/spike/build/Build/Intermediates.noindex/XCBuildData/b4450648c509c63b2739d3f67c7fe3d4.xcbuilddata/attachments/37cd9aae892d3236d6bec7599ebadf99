#!/bin/sh
set -e
APP="${TARGET_BUILD_DIR}/${CONTENTS_FOLDER_PATH}"
EXT_DIR="$APP/Contents/Library/SystemExtensions/com.vdev.camera.ext.spike.systemextension"
mkdir -p "$EXT_DIR/Contents/MacOS" "$APP/Contents/MacOS"
export COPYFILE_DISABLE=1
cp "${SRCROOT}/../../../target/release/vdev-camera-ext" "$EXT_DIR/Contents/MacOS/vdev-camera-ext"
cp "${SRCROOT}/ext-Info.plist" "$EXT_DIR/Contents/Info.plist"
cp "${SRCROOT}/../../../target/release/vdev-spike-host" "$APP/Contents/MacOS/vdev-spike-host"
find "$APP" -name '._*' -exec mv {} /tmp/ \;
codesign --force --sign "${EXPANDED_CODE_SIGN_IDENTITY}" \
  --entitlements "${SRCROOT}/ext.entitlements" --options runtime --timestamp=none "$EXT_DIR"
echo "bundled rust extension -> $EXT_DIR"

