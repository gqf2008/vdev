;
; vdev-hid.inf — vdev 虚拟键盘/鼠标（KMDF 内核 HID minidriver）
;
; 结构对照微软 vhidmini2 官方样例（KMDF 版）：MsHidKmdf.inf 自 build 22000 引入，
; 由它安装系统 HidKmdf 功能驱动；本驱动经 .Filters 节（FilterPosition=Lower）
; 挂为该设备下层过滤器，与驱动侧 WdfFdoInitSetFilter 相呼应。
;

[Version]
Signature="$Windows NT$"
Class = HIDClass
ClassGuid = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ManufacturerName%
CatalogFile=vdev-hid.cat
DriverVer = 08/22/2026,0.1.0.0
DriverPackageDisplayName=%DriverDisplayName%
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12 ; DIRID_DRIVERS

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
vdev_hid.sys  = 1,,

[Manufacturer]
; TargetOS 装饰：最低 Windows 11（build 22000）——MsHidKmdf.inf 的引入版本
%ManufacturerName%=Standard,NTamd64.10.0...22000

[Standard.NTamd64.10.0...22000]
%KbdName%=vdev_hid_kbd_Install, Root\vdev-hid
%MouseName%=vdev_hid_mouse_Install, Root\vdev-hid-mouse

; ================= 键盘 =====================

[vdev_hid_kbd_Install.NT]
CopyFiles=Drivers_Dir
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT

[Drivers_Dir]
vdev_hid.sys

[vdev_hid_kbd_Install.NT.HW]
AddReg = vdev_hid_kbd_HW
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT.HW

[vdev_hid_kbd_HW]
HKR,,Role,0x00010001,0 ; 0=键盘

[vdev_hid_kbd_Install.NT.Services]
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT.Services
; minidriver 服务 flag 0（非 SPSVCINST_ASSOCSERVICE）：关联服务由 Needs 继承的
; mshidkmdf 承担（每设备 INF 恰有一个关联服务，对照 vhidmini2 官方样例）
AddService = vdev_hid, 0x00000000, vdev_hid_Service_Inst

[vdev_hid_kbd_Install.NT.Filters]
AddFilter=vdev_hid,,vdev_hid_Filter_Install

[vdev_hid_kbd_Install.NT.Wdf]
KmdfService = vdev_hid, vdev_hid_wdfsect

; ================= 鼠标 =====================

[vdev_hid_mouse_Install.NT]
CopyFiles=Drivers_Dir
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT

[vdev_hid_mouse_Install.NT.HW]
AddReg = vdev_hid_mouse_HW
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT.HW

[vdev_hid_mouse_HW]
HKR,,Role,0x00010001,1 ; 1=鼠标

[vdev_hid_mouse_Install.NT.Services]
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT.Services
; minidriver 服务 flag 0（非 SPSVCINST_ASSOCSERVICE）：关联服务由 Needs 继承的
; mshidkmdf 承担（每设备 INF 恰有一个关联服务，对照 vhidmini2 官方样例）
AddService = vdev_hid, 0x00000000, vdev_hid_Service_Inst

[vdev_hid_mouse_Install.NT.Filters]
AddFilter=vdev_hid,,vdev_hid_Filter_Install

[vdev_hid_mouse_Install.NT.Wdf]
KmdfService = vdev_hid, vdev_hid_wdfsect

; ================= 过滤器 / 服务 / WDF =====================

[vdev_hid_Filter_Install]
FilterPosition=Lower

[vdev_hid_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\vdev_hid.sys

[vdev_hid_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
ManufacturerName="vdev"
DriverDisplayName="vdev HID Drivers"
DiskName="vdev HID Installation Disk"
KbdName="vdev 虚拟键盘"
MouseName="vdev 虚拟鼠标"
ServiceDesc="vdev HID Service"
