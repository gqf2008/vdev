// VDCamera (Windows) — vdev 虚拟摄像头宿主（Rust + Slint + slint-pixel）
import { PixelButton, PixelPanel, PixelText, PixelTitleBar, PixelTheme } from "@slint_pixel";
import { ScrollView } from "std-widgets.slint";

export global AppState {
    in-out property <string> status_glyph: "○";
    in-out property <string> status_title: "虚拟摄像头未安装";
    in-out property <string> status_detail: "点击「安装虚拟摄像头」，然后刷新状态确认。";
    in-out property <bool> can_install: true;
    in-out property <bool> can_uninstall: false;
    in-out property <bool> can_push: false;
    in-out property <string> push_btn_text: "开始推流";
    in-out property <string> log_text: "";
}

export component MainWindow inherits Window {
    title: "VDCamera (Windows)";
    no-frame: true;
    preferred-width: 560px;
    preferred-height: 540px;
    min-width: 560px;
    min-height: 540px;
    background: PixelTheme.bg;

    callback install();
    callback uninstall();
    callback refresh();
    callback push();
    callback drag-start();
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        PixelTitleBar {
            title: "VDCamera · vdev 虚拟摄像头 (Windows)";
            drag-start => { root.drag-start(); }
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
        }

        PixelPanel {
            title: "状态";
            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    PixelText { text: AppState.status_glyph; font-size: 18px; }
                    PixelText { text: AppState.status_title; font-weight: 700; }
                }
                PixelText { text: AppState.status_detail; font-size: 12px; color: PixelTheme.dim; wrap: word-wrap; }
            }
        }

        HorizontalLayout { spacing: 8px;
            PixelButton { text: "安装虚拟摄像头"; enabled: AppState.can_install; clicked => { install(); } }
            PixelButton { text: "卸载虚拟摄像头"; enabled: AppState.can_uninstall; clicked => { uninstall(); } }
            PixelButton { text: "刷新状态"; clicked => { refresh(); } }
        }

        HorizontalLayout { spacing: 8px;
            PixelButton { text: AppState.push_btn_text; enabled: AppState.can_push; clicked => { push(); } }
        }

        ScrollView {
            height: 160px;
            Text {
                text: AppState.log_text;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
}
